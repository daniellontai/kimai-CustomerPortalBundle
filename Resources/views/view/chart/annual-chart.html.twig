{% set chartId = 'statsPerMonthChart' %}
{% set backgroundColor = config('theme.chart.background_color') %}
{% set gridColor = config('theme.chart.grid_color') %}

<div class="chart">
    <canvas id="{{ chartId }}" style="height: {{ config('theme.chart.height') }}px;"></canvas>
</div>

<script type="text/javascript">
    new Chart(document.getElementById('{{ chartId }}').getContext('2d'), {
        type: 'bar',
        data: {
            labels: [
                {% if range.legacyMonth %}{% for name in month_names() %}'{{ name }}',{% endfor %}{% else %}{% for label, stat in statsPerMonth %}'{{ label }}',{% endfor %}{% endif %}
            ],
            datasets: [{
                label: '{{ 'duration' | trans }}',
                backgroundColor: '{{ backgroundColor }}',
                data: [
                    {% if range.legacyMonth %}{% for i in 1..12 %}{{ (statsPerMonth[i].duration / 3600) | number_format(2, '.', '') }},{% endfor %}{% else %}{% for stat in statsPerMonth %}{{ (stat.duration / 3600) | number_format(2, '.', '') }},{% endfor %}{% endif %}
                ],
                realData: [
                    {% if range.legacyMonth %}{% for i in 1..12 %}'{{ statsPerMonth[i].duration | duration }}',{% endfor %}{% else %}{% for stat in statsPerMonth %}'{{ stat.duration | duration }}',{% endfor %}{% endif %}
                ]
            }]
        },
        options: {
            maintainAspectRatio: false,
            responsive: true,
            legend: false,
            scales: {
                y: {
                    scaleLabel: {
                        display: true,
                        labelString: '{{ 'duration'|trans }}',
                    },
                    ticks: {
                        beginAtZero: true
                    },
                    gridLines: {
                        display: true,
                        color: '{{ gridColor }}',
                        lineWidth: 1
                    }
                },
            },
            tooltips: {
                callbacks: {
                    label: function (tooltipItem, data) {
                        return data.datasets[tooltipItem.datasetIndex].realData[tooltipItem.index];
                    }
                }
            },
        },
    });
</script>
